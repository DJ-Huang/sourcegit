<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:ai="using:SourceGit.AI"
                    xmlns:avaloniaEdit="using:AvaloniaEdit"
                    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="660"
                    x:Class="SourceGit.Views.DiffAnalysis"
                    x:DataType="vm:DiffAnalysis"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.DiffAnalysis}"
                    Width="900" Height="660" MinWidth="560" MinHeight="380"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <v:ChromelessWindow.Resources>
    <Thickness x:Key="ExpanderHeaderPadding">9,0,0,0</Thickness>
    <Thickness x:Key="ExpanderChevronMargin">6,0,8,0</Thickness>
    <x:Double x:Key="ExpanderChevronButtonSize">14</x:Double>
  </v:ChromelessWindow.Resources>

  <v:ChromelessWindow.Styles>
    <Style Selector="Expander.trace_row /template/ ToggleButton#ExpanderHeader /template/ Path#ExpandCollapseChevron">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Height" Value="5"/>
      <Setter Property="Stretch" Value="Uniform"/>
    </Style>
  </v:ChromelessWindow.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.AIAssist}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.DiffAnalysis}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <Grid Grid.Row="1" Margin="12,8,12,0" ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding Header}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding Header}" Classes="bold"/>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <v:LoadingIcon Width="14" Height="14" IsVisible="{Binding IsBusy}"/>
        <ComboBox MinWidth="140" MaxWidth="210" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                  IsVisible="{Binding HasProfiles}" IsEnabled="{Binding CanSelectProfile}" AutomationProperties.Name="CLI">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="ai:ExternalCliProfile">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="flat" Content="{DynamicResource Text.ExternalCLI.Configure}"
                IsVisible="{Binding !HasProfiles}" IsEnabled="{Binding !IsBusy}" Click="OnConfigureClicked"/>
        <Panel>
          <Panel IsVisible="{Binding HasProfiles}">
            <Button Classes="flat primary" MinWidth="92" Content="{Binding StartLabel}"
                    IsVisible="{Binding CanSelectProfile}" IsEnabled="{Binding CanStart}" Click="OnAskClicked"/>
          </Panel>
          <Button Classes="flat" MinWidth="92" Content="{DynamicResource Text.DiffAnalysis.Stop}"
                  IsVisible="{Binding IsBusy}" Click="OnStopClicked"/>
        </Panel>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Margin="12,8" BorderThickness="1" CornerRadius="4"
            BorderBrush="{DynamicResource Brush.Border2}" Background="{DynamicResource Brush.Contents}">
      <Panel>
        <v:AnalysisConversation x:Name="ConversationScroll" HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto" ScrollChanged="OnConversationScrollChanged">
          <ItemsControl Margin="12,10" ItemsSource="{Binding Entries}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="5"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DiffAnalysisEntry">
                <Panel>
                  <SelectableTextBlock Text="{Binding Heading}" IsVisible="{Binding IsNotice}"
                                       Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" Margin="2,3"/>
                  <Grid IsVisible="{Binding IsQuestion}" ColumnDefinitions="*,3*">
                    <Border Grid.Column="1" HorizontalAlignment="Right" Margin="4,3,0,3" Padding="10,6"
                            Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border2}"
                            BorderThickness="1" CornerRadius="8">
                      <SelectableTextBlock Text="{Binding Heading}" Foreground="{DynamicResource Brush.FG1}"
                                           TextWrapping="Wrap"/>
                    </Border>
                  </Grid>
                  <v:MarkdownView Markdown="{Binding AnswerMarkdown}" IsVisible="{Binding IsAnswer}" HorizontalContentAlignment="Stretch" Margin="2,6"/>
                  <Expander Classes="trace_row" MinWidth="0" MinHeight="28"
                            IsVisible="{Binding IsTrace}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="9,5"
                            BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1" CornerRadius="4">
                    <Expander.Header>
                      <TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Heading}"/>
                    </Expander.Header>
                    <ContentControl Content="{Binding ExpandedEntry}" HorizontalContentAlignment="Stretch">
                      <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:DiffAnalysisEntry">
                          <StackPanel Spacing="8" Margin="0,0,0,4">
                            <v:MarkdownView Markdown="{Binding Markdown}" IsVisible="{Binding HasMarkdown}" HorizontalContentAlignment="Stretch" Margin="0,4,0,0"/>
                            <avaloniaEdit:TextEditor Document="{Binding DetailsDocument, Mode=OneWay}" IsVisible="{Binding HasDetails}"
                                                     BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
                                                     Background="{DynamicResource Brush.Contents}"
                                                     FontFamily="{DynamicResource Fonts.Monospace}" FontSize="12"
                                                     IsReadOnly="True" MaxHeight="260"
                                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                          </StackPanel>
                        </DataTemplate>
                      </ContentControl.ContentTemplate>
                    </ContentControl>
                  </Expander>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </v:AnalysisConversation>
        <TextBlock Text="{Binding EmptyHint}" IsVisible="{Binding !HasEntries}" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Brush.FG2}"/>
      </Panel>
    </Border>

    <Grid Grid.Row="3" Margin="12,0,12,12" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding HasEntries}">
      <TextBox Grid.Column="0" Text="{Binding Question, Mode=TwoWay}"
               Watermark="{DynamicResource Text.DiffAnalysis.QuestionPlaceholder}"
               IsVisible="{Binding HasAnswer}"/>
      <Button Grid.Column="1" Margin="8,0,0,0" Classes="flat primary"
              Content="{DynamicResource Text.DiffAnalysis.Ask}" IsVisible="{Binding HasAnswer}" IsEnabled="{Binding CanAsk}"
              Click="OnAskClicked"/>
      <Button Grid.Column="2" Margin="8,0,0,0" Classes="flat"
              Content="{DynamicResource Text.Copy}">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="{DynamicResource Text.DiffAnalysis.CopySelection}" IsVisible="{Binding #ConversationScroll.HasSelection}"
                      Click="OnCopySelectionClicked"/>
            <MenuItem Header="{DynamicResource Text.DiffAnalysis.CopyMarkdown}" IsEnabled="{Binding HasAnswer}"
                      Click="OnCopyMarkdownClicked"/>
            <MenuItem Header="{DynamicResource Text.DiffAnalysis.CopyTranscript}" Click="OnCopyTranscriptClicked"/>
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>
  </Grid>
</v:ChromelessWindow>
