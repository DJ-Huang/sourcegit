<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:ai="using:SourceGit.AI"
                    mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="400"
                    x:Class="SourceGit.Views.AIAssistant"
                    x:DataType="vm:CommitAssistant"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.AIAssistant}"
                    Width="620" Height="460" MinWidth="530" MinHeight="330"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.AIAssist}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.AIAssistant}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
      <TabItem Header="API">
        <Grid RowDefinitions="Auto,*">
          <ComboBox Grid.Row="0" Margin="8" HorizontalAlignment="Stretch"
                    IsVisible="{Binding HasApiServices}"
                    PlaceholderText="{DynamicResource Text.AIAssistant.SelectService}"
                    ItemsSource="{Binding ApiServices}"
                    SelectedItem="{Binding SelectedApiService, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="ai:Service">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Grid.Row="1" Margin="8" TextWrapping="Wrap"
                     IsVisible="{Binding !HasApiServices}"
                     Text="{DynamicResource Text.AIAssistant.NoApiServices}"/>

          <ContentControl Grid.Row="1" Content="{Binding Api}" IsVisible="{Binding HasApiSelection}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:AIAssistant">
                <Grid RowDefinitions="*,Auto">
                  <!-- AI response -->
                  <v:AIResponseView Grid.Row="0"
                                    Margin="8"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border2}"
                                    Background="{DynamicResource Brush.Contents}"
                                    Content="{Binding Text}"/>

                  <!-- Options -->
                  <Grid Grid.Row="1" Margin="8,0,8,8" ColumnDefinitions="Auto,*,18,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               Classes="group_header_label"
                               Text="{DynamicResource Text.AIAssistant.Model}"/>

                    <ComboBox Grid.Column="1"
                              Height="28"
                              Margin="6,0" Padding="4,0"
                              BorderThickness="0"
                              Background="Transparent"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding AvailableModels, Mode=OneWay}"
                              SelectedItem="{Binding SelectedModel, Mode=TwoWay}"/>

                    <v:LoadingIcon Grid.Column="2"
                                   Width="14" Height="14"
                                   IsVisible="{Binding IsGenerating}"/>

                    <Button Grid.Column="3"
                            Classes="flat primary"
                            Height="28"
                            Margin="8,0" Padding="12,0"
                            Content="{DynamicResource Text.AIAssistant.Use}"
                            IsEnabled="{Binding Response, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Click="OnUseClicked"/>

                    <Button Grid.Column="4"
                            Classes="flat"
                            Height="28"
                            Padding="12,0"
                            Content="{DynamicResource Text.AIAssistant.Regen}"
                            IsEnabled="{Binding !IsGenerating}"
                            Click="OnRegenClicked"/>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Grid>
      </TabItem>
      <TabItem Header="CLI">
        <Grid RowDefinitions="Auto,*">
          <ComboBox Grid.Row="0" Margin="8" HorizontalAlignment="Stretch"
                    IsVisible="{Binding HasCliServices}"
                    IsEnabled="{Binding !Cli.IsCommitting, FallbackValue=True}"
                    PlaceholderText="{DynamicResource Text.AIAssistant.SelectService}"
                    ItemsSource="{Binding CliServices}"
                    SelectedItem="{Binding SelectedCliService, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="ai:Service">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Grid.Row="1" Margin="8" TextWrapping="Wrap"
                     IsVisible="{Binding !HasCliServices}"
                     Text="{DynamicResource Text.AIAssistant.NoCliServices}"/>

          <ContentControl Grid.Row="1" Content="{Binding Cli}" IsVisible="{Binding HasCliSelection}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:CliAssistant">
                <Grid RowDefinitions="*,Auto">
                  <!-- AI response -->
                  <v:AIResponseView Grid.Row="0"
                                    Margin="8"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border2}"
                                    Background="{DynamicResource Brush.Contents}"
                                    Content="{Binding Text}"/>

                  <!-- Options -->
                  <Grid Grid.Row="1" Margin="8,0,8,8" RowDefinitions="Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                      <TextBlock Grid.Column="0"
                                 Classes="group_header_label"
                                 VerticalAlignment="Center"
                                 Text="{DynamicResource Text.AIAssistant.BranchName}"/>

                      <TextBox Grid.Column="1"
                               Height="26"
                               Margin="6,0,0,0"
                               CornerRadius="3"
                               Text="{Binding BranchName, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,18,Auto,Auto,Auto">
                      <TextBlock Grid.Column="0"
                                 Classes="group_header_label"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding CommandText, Mode=OneWay}"/>

                      <v:LoadingIcon Grid.Column="1"
                                     Width="14" Height="14"
                                     IsVisible="{Binding IsGenerating}"/>

                      <Button Grid.Column="2"
                              Classes="flat"
                              Height="28"
                              Margin="8,0" Padding="12,0"
                              Content="{Binding GenerateLabel, Mode=OneWay}"
                              IsEnabled="{Binding !IsGenerating}"
                              Click="OnGenerateClicked"/>

                      <Button Grid.Column="3"
                              Classes="flat"
                              Height="28"
                              Padding="12,0"
                              Content="{DynamicResource Text.AIAssistant.Use}"
                              IsEnabled="{Binding Response, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Click="OnUseClicked"/>

                      <Button Grid.Column="4"
                              Classes="flat primary"
                              Height="28"
                              Margin="8,0,0,0" Padding="12,0"
                              Content="{DynamicResource Text.AIAssistant.CreateBranchAndCommit}"
                              IsEnabled="{Binding CanCreateBranch, Mode=OneWay}"
                              Click="OnCreateBranchAndCommitClicked"/>
                    </Grid>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</v:ChromelessWindow>
